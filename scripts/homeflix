#!/usr/bin/env python3
"""Repository-relative launcher for the Homeflix setup CLI."""

from pathlib import Path
import sys


SCRIPT_DIRECTORY = Path(__file__).resolve().parent
if str(SCRIPT_DIRECTORY) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIRECTORY))

from homeflix_setup.cli import main


if __name__ == "__main__":
    raise SystemExit(main(repository_root=SCRIPT_DIRECTORY.parent))
