# homeflix configuration — copy to .env and fill in.
#   cp .env.example .env
# .env holds real credentials and is gitignored. Never commit it.

# Stable Compose identity prevents a renamed checkout from creating a second stack.
COMPOSE_PROJECT_NAME=homeflix

# ─────────────────────────────────────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────────────────────────────────────
# CRITICAL: DATA_ROOT must be ONE filesystem containing torrents/, usenet/ and
# media/. That is what makes imports instant hardlinks instead of slow copies,
# and what lets torrents keep seeding after import. If media and downloads end up
# on different drives, hardlinks are impossible and seeding breaks.
#
# Do NOT put these under /home — home directories have restrictive default
# permissions that create a mess for containers running as PUID/PGID.
#
# The values below are portable examples, not verified mount choices. Follow
# docs/quickstart.md or let the setup agent validate existing mounted storage before
# creating the layout. Never run path-mutating commands with an unset variable.

DATA_ROOT=/srv/homeflix/data
CONFIG_ROOT=/srv/homeflix/appdata
CACHE_ROOT=/srv/homeflix/cache

# ─────────────────────────────────────────────────────────────────────────────
# Host / user
# ─────────────────────────────────────────────────────────────────────────────
# Must own DATA_ROOT and CONFIG_ROOT. Check with: id -u && id -g
PUID=1000
PGID=1000
TZ=UTC
LOG_LEVEL=info

# Profile name is resolved to a service-specific ID during API configuration.
QUALITY_PROFILE=HD-1080p

# Generated locally by `scripts/homeflix configure`; never populated in this template.
JELLYFIN_ADMIN_USER=
JELLYFIN_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Networking
# ─────────────────────────────────────────────────────────────────────────────
# Services are reachable at <service>.${DOMAIN} (jellyfin.homeflix, radarr.homeflix, …).
# These names must resolve on your LAN — via your router, Pi-hole, or /etc/hosts
# on each device. Traefik does not provide DNS.
# `.homeflix` is the product default. It is not a reserved TLD — serve it locally
# so queries are not forwarded to the public internet. `home.arpa` is the RFC 8375
# leak-safe alternative. Keep `.local` only for real mDNS/Avahi.
DOMAIN=homeflix
JELLYFIN_PUBLISHED_URL=http://jellyfin.homeflix

# Subnets allowed to bypass the VPN tunnel. `homeflix setup` discovers LAN_SUBNET from
# your default route and picks a non-conflicting PROXY_SUBNET, so you normally do not
# edit these by hand. To check them yourself:
#   ip -4 route show default    # the interface facing your LAN
#   ip -4 addr show dev <iface> # its address and prefix, e.g. 192.168.1.23/24
#
# ⚠️ Keep both as narrow as they really are. LAN_SUBNET must be RFC1918 or CGNAT;
# public prefixes are refused because they would create a public bypass around the VPN.
# Do NOT widen either value to a whole private block such as 10.0.0.0/8. VPN providers
# place their gateway inside private address space —
# ProtonVPN uses 10.2.0.1 — so an over-broad entry makes Gluetun route the provider's own
# gateway out of your LAN interface. Port forwarding (NAT-PMP) then fails with an i/o
# timeout to <gateway>:5351 while the tunnel still reports healthy and the public IP still
# looks correct, so nothing appears wrong.
#
# Erring the other way is loud and easy to spot: too narrow, and the kill switch blocks LAN
# access to the qBittorrent, NZBGet and Prowlarr web UIs.
LAN_SUBNET="192.168.1.0/24"

# The Compose network Traefik uses to reach the services behind Gluetun. It is pinned
# rather than left to Docker, because an unpinned bridge can be reallocated a different
# subnet on any recreate — which would invalidate the allowlist above. Agent setup avoids
# existing host routes and preserves an existing Homeflix-owned network on reruns. Change
# it manually only after verifying that it does not collide with another host route.
#
# PROXY_SUBNET and PROXY_NETWORK_SUBNET are aliases. Compose interpolates either name.
# Older checkouts may only set PROXY_NETWORK_SUBNET; new checkouts can set PROXY_SUBNET.
# Keep the two values equal when both are present.
PROXY_SUBNET="172.30.0.0/24"
PROXY_NETWORK_SUBNET="172.30.0.0/24"

# ─────────────────────────────────────────────────────────────────────────────
# VPN (Gluetun) — REQUIRED. qBittorrent, NZBGet and Prowlarr route through this.
# ─────────────────────────────────────────────────────────────────────────────
# Gluetun supports ~40 providers; see https://github.com/qdm12/gluetun-wiki
# The kill switch (FIREWALL=on) is always enabled: if the VPN drops, those three
# services lose all networking rather than leaking. Downloads stop until it recovers.
#
# Fill in the pair that matches VPN_TYPE and leave the other empty.
#
# wireguard (default): generate a config at your provider and copy its PrivateKey.
#   ProtonVPN: enable "NAT-PMP (Port Forwarding)" while generating, or the key
#   cannot forward a port. See the Gluetun ProtonVPN wiki.
# openvpn: use the provider's OpenVPN credentials, NOT your account login password.
#   For ProtonVPN, append "+pmp" to the username for port forwarding.
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
VPN_WIREGUARD_PRIVATE_KEY=
VPN_USER=
VPN_PASSWORD=
VPN_SERVER_COUNTRIES=Netherlands
VPN_DNS=1.1.1.1

# A forwarded port lets qBittorrent accept incoming connections. Without one,
# downloads still work but degrade on small swarms and seeding effectively stops.
# PORT_FORWARD_ONLY restricts server choice to port-forwarding (P2P) servers.
# ProtonVPN assigns a NEW random port on every reconnect, so compose runs
# scripts/gluetun-qbt-port.sh on each assignment. That script talks to
# qBittorrent over localhost, so enable Options > WebUI > "Bypass authentication
# for clients on localhost".
VPN_PORT_FORWARDING=on
VPN_PORT_FORWARD_ONLY=on

# What gluetun's built-in healthcheck probes through the tunnel. If it fails,
# gluetun restarts itself and deunhealth restarts the services behind it.
VPN_HEALTH_TARGET=cloudflare.com:443

# ─────────────────────────────────────────────────────────────────────────────
# Ports
# ─────────────────────────────────────────────────────────────────────────────
# These are published by the gluetun container, not by the services themselves.
QBITTORRENT_PORT=6969
TORRENT_PORT=6881
NZBGET_PORT=6789
PROWLARR_PORT=9696

# ─────────────────────────────────────────────────────────────────────────────
# Image tags
# ─────────────────────────────────────────────────────────────────────────────
# Defaults are :latest. Pin real versions here if you'd rather not have Watchtower
# auto-update a family-critical box overnight.
TRAEFIK_TAG=v3.0
GLUETUN_TAG=latest
QBITTORRENT_TAG=latest
NZBGET_TAG=latest
PROWLARR_TAG=latest
RADARR_TAG=latest
SONARR_TAG=latest
LIDARR_TAG=latest
BAZARR_TAG=latest
JELLYFIN_TAG=latest
JELLYSEERR_TAG=latest
GLANCES_TAG=latest
DEUNHEALTH_TAG=latest
WATCHTOWER_TAG=latest

# 6-field cron (seconds first). Default: daily at 02:00.
# Quoted so Compose and dotenv parsers treat the 6-field cron as one value.
WATCHTOWER_SCHEDULE="0 0 2 * * *"

# ─────────────────────────────────────────────────────────────────────────────
# Off-box CONFIG_ROOT backup (scripts/backup-config.sh)
# ─────────────────────────────────────────────────────────────────────────────
# Destination for dated homeflix-config-<UTC>.tar.gz archives. rsync form:
#   user@host:/path/to/dir
# or a local directory on a *different* filesystem than DATA_ROOT.
# Same-disk as the library is not a backup. Media is not included.
# Leave empty until you have a real destination; the script refuses to run
# without one. Install the daily job with: ./scripts/backup-config.sh --install-cron
# This does not back up the checkout's .env — that file is a separate secret.
BACKUP_DEST=
# How many dated archives to keep at the destination (oldest deleted first).
BACKUP_KEEP=7
